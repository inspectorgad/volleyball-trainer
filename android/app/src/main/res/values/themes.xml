<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only visible for the instant before Chrome takes over, so it just has
         to match the splash rather than style any real UI. Plain Material is
         fine: androidbrowserhelper's LauncherActivity does not require an
         AppCompat theme, and pulling appcompat in collides with
         androidbrowserhelper's kotlin-stdlib. -->
    <style name="Theme.App" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/colorPrimary</item>
        <item name="android:navigationBarColor">@color/colorPrimary</item>
        <item name="android:windowBackground">@color/backgroundColor</item>
    </style>
</resources>
